# ==============================================================================
# Collaborative Multi-Agent AI SOC - Environment Configuration Template
# ==============================================================================

# GROQ API Configuration
# Get your API key at: https://console.groq.com/keys
# If omitted or invalid, the platform automatically engages the deterministic Mock Provider
GROQ_API_KEY="MY_GROQ_API_KEY"

# Primary LLM Model for Multi-Agent Orchestration
# Supported: llama-3.3-70b-versatile, llama-3.1-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_DEFAULT_MODEL="llama-3.3-70b-versatile"
GROQ_FAST_MODEL="llama-3.1-8b-instant"

# Database Persistence
# Supports SQLite (sqlite:///./soc_data.db) or PostgreSQL (postgresql+asyncpg://soc_user:password@localhost:5432/soc_db)
DATABASE_URL="sqlite:///./soc_data.db"

# Server Ports
API_PORT=8880
DASHBOARD_PORT=3000
